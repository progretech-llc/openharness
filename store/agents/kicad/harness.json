{
  "spec": 1,
  "id": "autonomous/kicad",
  "name": "KiCad",
  "category": "PCB",
  "author": "KiCad",
  "formerly": [
    "autonomous/solder"
  ],
  "description": "Describe a board; get a real KiCad project \u2014 a wired schematic, DRC-checked copper, a prototype packet \u2014 with a live board view.",
  "engine": "codex",
  "workspace": {
    "template": "upstream/harness/kicad/template",
    "marker": "project.json",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "upstream/harness/kicad/AGENTS.md",
    "skills": [
      "upstream/harness/kicad/skills"
    ],
    "env": {
      "KICAD_HARNESS_PYTHON": "${dsh}/upstream/harness/kicad/toolchain/python",
      "CIRCUIT_PYTHON": "${dsh}/toolchain/python",
      "KICAD_HARNESS_ROOT": "${dsh}/upstream",
      "KICAD_HARNESS_BLOCKS": "${dsh}/upstream/packages/golden-blocks/blocks",
      "CIRCUIT_TOOLCHAIN": "${dsh}/upstream/toolchain",
      "KICAD_HARNESS_PICO_SDK": "${dsh}/upstream/toolchain/pico/pico-sdk",
      "KICAD_HARNESS_ARM_TOOLCHAIN": "${dsh}/upstream/toolchain/pico/arm-gnu-toolchain",
      "PICO_SDK_PATH": "${dsh}/upstream/toolchain/pico/pico-sdk",
      "PICO_TOOLCHAIN_PATH": "${dsh}/upstream/toolchain/pico/arm-gnu-toolchain",
      "CMAKE_PREFIX_PATH": "${dsh}/upstream/toolchain/pico/picotool",
      "KICAD_HARNESS_CMAKE": "${dsh}/upstream/toolchain/pico/tools/bin/cmake",
      "KICAD_HARNESS_NINJA": "${dsh}/upstream/toolchain/pico/tools/bin/ninja",
      "KICADPY_CLI": "${dsh}/.runtime/kicad-bridge/kicad-cli",
      "KICADPY_PYTHON": "${dsh}/.runtime/kicad-bridge/python",
      "CIRCUIT_KICAD_CLI": "${dsh}/.runtime/kicad-bridge/kicad-cli",
      "KICAD_HARNESS_SHARE": "${dsh}/.runtime/kicad-bridge/share",
      "CIRCUIT_SKILLS_DIR": "${workspace}/.agents/skills",
      "DISABLE_AUTOUPDATER": "1"
    },
    "args": [
      "--profile",
      "local",
      "-c",
      "hooks.Stop=[{hooks=[{type=\"command\",command=\"\\\"$KICAD_HARNESS_PYTHON\\\" -m kicadpy.autofinish\",timeout=1200}]}]",
      "-c",
      "hooks.Interrupt=[{hooks=[{type=\"command\",command=\"\\\"$KICAD_HARNESS_PYTHON\\\" -m kicadpy.autofinish\",timeout=3}]}]"
    ]
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "command": "toolchain/viewer.sh",
    "url": "http://127.0.0.1:${port}/"
  },
  "verdict": ".harness/verdict.json"
}
